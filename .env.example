APP_NAME="StudioLive Backend"
APP_ENV=development
DEBUG=true

# JWT Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studiolive

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS (Local development defaults to MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=studiolive-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_SNS_ENABLED=false

# OTP settings
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Payment Gateway (Razorpay mock credentials)
RAZORPAY_API_KEY=rzp_test_mockkey
RAZORPAY_API_SECRET=mock_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret
